{
  "compilerOptions": {
    "jsx": "react",  // 关键配置：允许 JSX 语法
    "module": "ESNext",
    "target": "ES6",
    "sourceMap": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationDir": "lib",
    "outDir": "lib"
  },
  "include": ["src/**/*"]  // 包含所有源码
}